<?xml version='1.0' encoding='UTF-8'?>  
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
    <hibernate-mapping>
     <class name="manytomany.Question" table="manytomanyQuestionHbm">
    <id name="qid">
    <generator class="increment"></generator>
    </id>
    <property name="qname"></property>
<list name="ans" fetch="join" cascade="all">
<key column="qid">
</key><index column="type"></index>
 <many-to-many class="manytomany.Answer"></many-to-many>
</list>
         
  </class>
  </hibernate-mapping>