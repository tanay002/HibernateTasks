<?xml version='1.0' encoding='UTF-8'?>  
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
    <hibernate-mapping>
    <class name="com.hibernate.Inheritance.College" table="collegeDetail" discriminator-value="clg">
    <id name="cid">
    <generator class="increment"/>
    </id>   
       <discriminator column="ds" type="string"></discriminator>
    <property name="cname"></property>
  
    <subclass name="com.hibernate.Inheritance.Student" discriminator-value="stu">
    <property name="sname"></property>
    </subclass>
    
    <subclass name="com.hibernate.Inheritance.Faculty" discriminator-value="fac">
    <property name="fname"></property>
    </subclass>
    </class>
    </hibernate-mapping>